{
  "openapi": "3.1.0",
  "info": {
    "title": "Spectre Meltdown Transient Agent API",
    "description": "Illustrative metric-rule evaluator with an in-memory audit chain. No clinical or hardware-security validation.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service process available"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory JSON counters",
        "responses": {
          "200": {
            "description": "JSON in-memory counters (not Prometheus exposition format)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Classify input metrics using example worker rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Classification dossier referencing an in-memory signed audit entry"
          },
          "400": {
            "description": "Identifier rejected by pattern guard"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response; no external language model",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          },
          "400": {
            "description": "Identifier rejected by pattern guard"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit metadata (requires configured X-Audit-Token)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Missing or invalid token"
          },
          "503": {
            "description": "Audit log access disabled"
          }
        },
        "security": [
          {
            "AuditLogToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuditLogToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Audit-Token",
        "description": "Only available when AUDIT_LOG_READ_TOKEN is configured on the server."
      }
    }
  }
}
